#!/usr/bin/env sh
# React Native/Android tooling often expects ./gradlew in the project root.
# If permissions are stripped, this wrapper still works by invoking via sh.
if [ -f "./gradlew.sh" ]; then
  sh "./gradlew.sh" "$@"
elif [ -f "./android/gradlew" ]; then
  sh "./android/gradlew" "$@"
else
  echo "frontend gradlew shim: no android gradle wrapper found; nothing to do."
  exit 0
fi
